# Template only. Store real values outside the repository; backend/.env is not loaded.
# Keep passwords in a private libpq passfile instead of this URL.
INVESTMENT_STUDIO_DATA_ENVIRONMENT=development
INVESTMENT_STUDIO_DATA_WATCHLIST_API_URL=http://127.0.0.1:8000
INVESTMENT_STUDIO_DATA_PORTFOLIO_API_URL=http://127.0.0.1:8001
INVESTMENT_STUDIO_DATA_DATABASE_URL=postgresql+psycopg://APP_USER@DB_HOST:5432/APP_DATABASE
INVESTMENT_STUDIO_DATA_ALEMBIC_DATABASE_URL=postgresql+psycopg://MIGRATION_USER@DB_HOST:5432/APP_DATABASE
INVESTMENT_STUDIO_DATA_DATABASE_SCHEMA=instrument_data
INVESTMENT_STUDIO_DATA_OPERATIONS_DATABASE_SCHEMA=data_ingestion
INVESTMENT_STUDIO_DATA_SQL_ECHO=false

# Shared NAV email refresh
INVESTMENT_STUDIO_DATA_EMAIL_SYNC_ENABLED=false
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_HOST=imap.example.com
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_PORT=993
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_USERNAME=nav-sync@example.com
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_PASSWORD=replace-with-real-password
# Exact folders scanned in order. INBOX remains required because many tracked
# funds are not filed into a dedicated mailbox folder.
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_FOLDERS=INBOX,jingxuan1,junheng,yungu3
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_USE_SSL=true
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_TIMEOUT_SECONDS=60
INVESTMENT_STUDIO_DATA_EMAIL_IMAP_MARK_SEEN=false
INVESTMENT_STUDIO_DATA_EMAIL_HISTORY_START_DATE=2025-12-26
INVESTMENT_STUDIO_DATA_EMAIL_HEADER_FETCH_BATCH_SIZE=200
INVESTMENT_STUDIO_DATA_EMAIL_MESSAGE_FETCH_BATCH_SIZE=20
INVESTMENT_STUDIO_DATA_EMAIL_ATTACHMENT_MAX_BYTES=26214400
INVESTMENT_STUDIO_DATA_EMAIL_INGESTION_LEASE_SECONDS=1800
INVESTMENT_STUDIO_DATA_MARKET_DATA_BATCH_ITEM_TIMEOUT_SECONDS=300

# DataHub REST transport for the Tushare datasets used by the Registry.
INVESTMENT_STUDIO_DATA_DATAHUB_API_KEY=replace-with-real-api-key
INVESTMENT_STUDIO_DATA_DATAHUB_TUSHARE_API_URL=http://datahubco.com/app-api/openapi/v1/tushare
INVESTMENT_STUDIO_DATA_DATAHUB_TIMEOUT_SECONDS=30
INVESTMENT_STUDIO_DATA_DATAHUB_TUSHARE_BATCH_TIMEOUT_SECONDS=3600

# Direct FMP API source for on-demand US, Hong Kong, and China A-share equities.
INVESTMENT_STUDIO_DATA_FMP_API_KEY_FILE=/absolute/path/to/fmp_api_key
INVESTMENT_STUDIO_DATA_FMP_API_URL=https://financialmodelingprep.com/stable
INVESTMENT_STUDIO_DATA_FMP_TIMEOUT_SECONDS=30

# Unified account service; see docs/MULTI_ACCOUNT_SYSTEM.md for local/cloud cookie setup.
INVESTMENT_STUDIO_AUTH_URL=http://127.0.0.1:8002/api/auth
INVESTMENT_STUDIO_AUTH_COOKIE_NAME=__Secure-yungu_session
# Use a Home-issued 0600 service token file for this app's documented scopes.
# INVESTMENT_STUDIO_AUTH_SERVICE_TOKEN_FILE=/absolute/private/path/service-token
