# Template only. Store real values outside the repository; backend/.env is not loaded.
# Keep passwords in a private libpq passfile instead of this URL.
PORTFOLIO_OPS_PORTFOLIO_ENVIRONMENT=development
PORTFOLIO_OPS_PORTFOLIO_FRONTEND_URL=http://127.0.0.1:5174
PORTFOLIO_OPS_PORTFOLIO_DATABASE_URL=postgresql+psycopg://APP_USER@DB_HOST:5432/APP_DATABASE
PORTFOLIO_OPS_PORTFOLIO_DATABASE_SCHEMA=portfolio
PORTFOLIO_OPS_PORTFOLIO_SQL_ECHO=false
PORTFOLIO_OPS_PORTFOLIO_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
PORTFOLIO_OPS_PORTFOLIO_DEFAULT_TRADE_TIMEZONE=Asia/Shanghai
PORTFOLIO_OPS_PORTFOLIO_DEFAULT_TRADE_TIME=12:00

# Optional migration/runtime overrides
# PORTFOLIO_OPS_PORTFOLIO_ALEMBIC_DATABASE_URL=postgresql+psycopg://MIGRATION_USER@DB_HOST:5432/APP_DATABASE
# PORTFOLIO_OPS_PORTFOLIO_RESEARCH_OUTPUTS_ROOT=research_outputs
