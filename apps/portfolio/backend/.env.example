# Template only. Store real values outside the repository; backend/.env is not loaded.
# Keep passwords in a private libpq passfile instead of this URL.
INVESTMENT_STUDIO_PORTFOLIO_ENVIRONMENT=development
INVESTMENT_STUDIO_PORTFOLIO_FRONTEND_URL=http://127.0.0.1:5174
INVESTMENT_STUDIO_PORTFOLIO_DATABASE_URL=postgresql+psycopg://APP_USER@DB_HOST:5432/APP_DATABASE
INVESTMENT_STUDIO_PORTFOLIO_DATABASE_SCHEMA=portfolio
INVESTMENT_STUDIO_PORTFOLIO_SQL_ECHO=false
# Enable only in a personal local environment; keep false on the shared server.
INVESTMENT_STUDIO_PORTFOLIO_RESEARCH_ENABLED=true
INVESTMENT_STUDIO_PORTFOLIO_WATCHLIST_API_URL=http://127.0.0.1:8000/api
INVESTMENT_STUDIO_PORTFOLIO_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
INVESTMENT_STUDIO_PORTFOLIO_DEFAULT_TRADE_TIMEZONE=Asia/Shanghai
INVESTMENT_STUDIO_PORTFOLIO_DEFAULT_TRADE_TIME=12:00
INVESTMENT_STUDIO_PORTFOLIO_DAILY_SNAPSHOT_WORKER_ENABLED=true
INVESTMENT_STUDIO_PORTFOLIO_DAILY_SNAPSHOT_WORKER_POLL_SECONDS=5.0
INVESTMENT_STUDIO_PORTFOLIO_DAILY_SNAPSHOT_WORKER_RECONCILIATION_BATCH_SIZE=32
INVESTMENT_STUDIO_PORTFOLIO_DAILY_SNAPSHOT_WORKER_SHUTDOWN_SECONDS=5.0
INVESTMENT_STUDIO_PORTFOLIO_COPILOT_ANALYSIS_TIMEOUT_SECONDS=900.0

# Optional migration/runtime overrides
# INVESTMENT_STUDIO_PORTFOLIO_ALEMBIC_DATABASE_URL=postgresql+psycopg://MIGRATION_USER@DB_HOST:5432/APP_DATABASE
# INVESTMENT_STUDIO_PORTFOLIO_RESEARCH_OUTPUTS_ROOT=research_outputs
