# Template only. Store real values outside the repository; backend/.env is not loaded.
# Keep passwords in a private libpq passfile instead of this URL.
INVESTMENT_STUDIO_WATCHLIST_ENVIRONMENT=development
INVESTMENT_STUDIO_WATCHLIST_FRONTEND_URL=http://127.0.0.1:5173
INVESTMENT_STUDIO_WATCHLIST_DATABASE_URL=postgresql+psycopg://APP_USER@DB_HOST:5432/APP_DATABASE
INVESTMENT_STUDIO_WATCHLIST_DATABASE_SCHEMA=watchlist
INVESTMENT_STUDIO_WATCHLIST_SQL_ECHO=false
INVESTMENT_STUDIO_WATCHLIST_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Durable recalc worker
INVESTMENT_STUDIO_WATCHLIST_RECALC_WORKER_ENABLED=true
INVESTMENT_STUDIO_WATCHLIST_RECALC_WORKER_POLL_INTERVAL_SECONDS=1
INVESTMENT_STUDIO_WATCHLIST_RECALC_WORKER_SHUTDOWN_TIMEOUT_SECONDS=5
INVESTMENT_STUDIO_WATCHLIST_RECALC_WORKER_RUNNING_JOB_TIMEOUT_SECONDS=300
INVESTMENT_STUDIO_WATCHLIST_RECALC_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
INVESTMENT_STUDIO_WATCHLIST_RECALC_WORKER_RECONCILE_INTERVAL_SECONDS=60
INVESTMENT_STUDIO_WATCHLIST_RECALC_WORKER_RECONCILE_BATCH_SIZE=500
INVESTMENT_STUDIO_WATCHLIST_DOCUMENT_STORAGE_ROOT=../var/watchlist-documents
INVESTMENT_STUDIO_WATCHLIST_DOCUMENT_UPLOAD_MAX_BYTES=26214400

# Research tool callbacks and optional cross-app evidence (server ports differ).
INVESTMENT_STUDIO_WATCHLIST_RESEARCH_API_BASE_URL=http://127.0.0.1:8000/api
INVESTMENT_STUDIO_WATCHLIST_RESEARCH_PORTFOLIO_API_URL=http://127.0.0.1:8001/api
INVESTMENT_STUDIO_WATCHLIST_RESEARCH_REGIME_API_URL=http://127.0.0.1:3011/api

# Optional migration override
# INVESTMENT_STUDIO_WATCHLIST_ALEMBIC_DATABASE_URL=postgresql+psycopg://MIGRATION_USER@DB_HOST:5432/APP_DATABASE
