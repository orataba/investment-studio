# Template only. Store real values outside the repository; backend/.env is not loaded.
# Keep passwords in a private libpq passfile instead of this URL.
PORTFOLIO_OPS_WATCHLIST_ENVIRONMENT=development
PORTFOLIO_OPS_WATCHLIST_FRONTEND_URL=http://127.0.0.1:5173
PORTFOLIO_OPS_WATCHLIST_DATABASE_URL=postgresql+psycopg://APP_USER@DB_HOST:5432/APP_DATABASE
PORTFOLIO_OPS_WATCHLIST_DATABASE_SCHEMA=watchlist
PORTFOLIO_OPS_WATCHLIST_SQL_ECHO=false
PORTFOLIO_OPS_WATCHLIST_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Durable recalc worker
PORTFOLIO_OPS_WATCHLIST_RECALC_WORKER_ENABLED=true
PORTFOLIO_OPS_WATCHLIST_RECALC_WORKER_POLL_INTERVAL_SECONDS=1
PORTFOLIO_OPS_WATCHLIST_RECALC_WORKER_SHUTDOWN_TIMEOUT_SECONDS=5
PORTFOLIO_OPS_WATCHLIST_RECALC_WORKER_RUNNING_JOB_TIMEOUT_SECONDS=300
PORTFOLIO_OPS_WATCHLIST_RECALC_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
PORTFOLIO_OPS_WATCHLIST_RECALC_WORKER_RECONCILE_INTERVAL_SECONDS=60
PORTFOLIO_OPS_WATCHLIST_RECALC_WORKER_RECONCILE_BATCH_SIZE=500
PORTFOLIO_OPS_WATCHLIST_DOCUMENT_STORAGE_ROOT=../var/watchlist-documents
PORTFOLIO_OPS_WATCHLIST_DOCUMENT_UPLOAD_MAX_BYTES=26214400

# Optional migration override
# PORTFOLIO_OPS_WATCHLIST_ALEMBIC_DATABASE_URL=postgresql+psycopg://MIGRATION_USER@DB_HOST:5432/APP_DATABASE
