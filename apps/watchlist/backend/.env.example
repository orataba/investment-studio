FTV2_ENVIRONMENT=development
FTV2_FRONTEND_URL=http://127.0.0.1:4173
FTV2_DATABASE_URL=postgresql+psycopg://yungu:yungu@127.0.0.1:5432/yungu
FTV2_DATABASE_SCHEMA=watchlist
FTV2_SQL_ECHO=false
FTV2_CORS_ORIGINS=["http://127.0.0.1:4173"]

# NAV email refresh
FTV2_EMAIL_SYNC_ENABLED=false
FTV2_EMAIL_IMAP_HOST=imap.example.com
FTV2_EMAIL_IMAP_PORT=993
FTV2_EMAIL_IMAP_USERNAME=nav-sync@example.com
FTV2_EMAIL_IMAP_PASSWORD=replace-with-real-password
FTV2_EMAIL_IMAP_FOLDER=INBOX
FTV2_EMAIL_IMAP_USE_SSL=true
FTV2_EMAIL_IMAP_MAX_MESSAGES=20
FTV2_EMAIL_IMAP_MARK_SEEN=false

# AI copilot
FTV2_COPILOT_PROVIDER=stub
FTV2_COPILOT_OPENAI_MODEL=gpt-5.4
FTV2_COPILOT_OPENAI_API_KEY=
