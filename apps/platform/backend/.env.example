YUNGU_PLATFORM_ENVIRONMENT=development
YUNGU_PLATFORM_FRONTEND_URL=http://127.0.0.1:5172
YUNGU_PLATFORM_CORS_ORIGINS=["http://127.0.0.1:5172"]
YUNGU_PLATFORM_WATCHLIST_URL=http://127.0.0.1:5173
YUNGU_PLATFORM_PORTFOLIO_URL=http://127.0.0.1:5174
YUNGU_PLATFORM_WATCHLIST_API_URL=http://127.0.0.1:8000
YUNGU_PLATFORM_PORTFOLIO_API_URL=http://127.0.0.1:8001
YUNGU_PLATFORM_DATABASE_URL=postgresql+psycopg://yungu:yungu@127.0.0.1:5432/yungu
YUNGU_PLATFORM_DATABASE_SCHEMA=instrument_registry

# Shared NAV email refresh
YUNGU_PLATFORM_EMAIL_SYNC_ENABLED=false
YUNGU_PLATFORM_EMAIL_IMAP_HOST=imap.example.com
YUNGU_PLATFORM_EMAIL_IMAP_PORT=993
YUNGU_PLATFORM_EMAIL_IMAP_USERNAME=nav-sync@example.com
YUNGU_PLATFORM_EMAIL_IMAP_PASSWORD=replace-with-real-password
YUNGU_PLATFORM_EMAIL_IMAP_FOLDER=INBOX
YUNGU_PLATFORM_EMAIL_IMAP_USE_SSL=true
YUNGU_PLATFORM_EMAIL_IMAP_TIMEOUT_SECONDS=60
YUNGU_PLATFORM_EMAIL_IMAP_MAX_MESSAGES=20
YUNGU_PLATFORM_EMAIL_IMAP_MARK_SEEN=false

# Tushare-compatible SDK endpoint from the 15000-point proxy plan.
YUNGU_PLATFORM_TUSHARE_TOKEN=replace-with-real-token
YUNGU_PLATFORM_TUSHARE_API_URL=https://fastapic.stockai888.top
