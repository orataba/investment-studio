# Template only. Store real values outside the repository; backend/.env is not loaded.
# Keep passwords in a private libpq passfile instead of this URL.
PORTFOLIO_OPS_PLATFORM_ENVIRONMENT=development
PORTFOLIO_OPS_PLATFORM_FRONTEND_URL=http://127.0.0.1:5172
PORTFOLIO_OPS_PLATFORM_CORS_ORIGINS=["http://127.0.0.1:5172"]
PORTFOLIO_OPS_PLATFORM_WATCHLIST_URL=http://127.0.0.1:5173
PORTFOLIO_OPS_PLATFORM_PORTFOLIO_URL=http://127.0.0.1:5174
PORTFOLIO_OPS_PLATFORM_WATCHLIST_API_URL=http://127.0.0.1:8000
PORTFOLIO_OPS_PLATFORM_PORTFOLIO_API_URL=http://127.0.0.1:8001
PORTFOLIO_OPS_PLATFORM_DATABASE_URL=postgresql+psycopg://APP_USER@DB_HOST:5432/APP_DATABASE
PORTFOLIO_OPS_PLATFORM_ALEMBIC_DATABASE_URL=postgresql+psycopg://MIGRATION_USER@DB_HOST:5432/APP_DATABASE
PORTFOLIO_OPS_PLATFORM_DATABASE_SCHEMA=instrument_registry
PORTFOLIO_OPS_PLATFORM_OPERATIONS_DATABASE_SCHEMA=platform

# Shared NAV email refresh
PORTFOLIO_OPS_PLATFORM_EMAIL_SYNC_ENABLED=false
PORTFOLIO_OPS_PLATFORM_EMAIL_IMAP_HOST=imap.example.com
PORTFOLIO_OPS_PLATFORM_EMAIL_IMAP_PORT=993
PORTFOLIO_OPS_PLATFORM_EMAIL_IMAP_USERNAME=nav-sync@example.com
PORTFOLIO_OPS_PLATFORM_EMAIL_IMAP_PASSWORD=replace-with-real-password
# Exact folders scanned in order. INBOX remains required because many tracked
# funds are not filed into a dedicated mailbox folder.
PORTFOLIO_OPS_PLATFORM_EMAIL_IMAP_FOLDERS=INBOX,jingxuan1,junheng,yungu3
PORTFOLIO_OPS_PLATFORM_EMAIL_IMAP_USE_SSL=true
PORTFOLIO_OPS_PLATFORM_EMAIL_IMAP_TIMEOUT_SECONDS=60
PORTFOLIO_OPS_PLATFORM_EMAIL_HISTORY_START_DATE=2025-12-26
PORTFOLIO_OPS_PLATFORM_EMAIL_HEADER_FETCH_BATCH_SIZE=200
PORTFOLIO_OPS_PLATFORM_EMAIL_MESSAGE_FETCH_BATCH_SIZE=20
PORTFOLIO_OPS_PLATFORM_EMAIL_ATTACHMENT_MAX_BYTES=26214400
PORTFOLIO_OPS_PLATFORM_EMAIL_INGESTION_LEASE_SECONDS=1800
PORTFOLIO_OPS_PLATFORM_MARKET_DATA_BATCH_ITEM_TIMEOUT_SECONDS=300

# DataHub REST transport for the Tushare datasets used by the Registry.
PORTFOLIO_OPS_PLATFORM_DATAHUB_API_KEY=replace-with-real-api-key
PORTFOLIO_OPS_PLATFORM_DATAHUB_TUSHARE_API_URL=http://datahubco.com/app-api/openapi/v1/tushare
PORTFOLIO_OPS_PLATFORM_DATAHUB_TIMEOUT_SECONDS=30
PORTFOLIO_OPS_PLATFORM_DATAHUB_TUSHARE_BATCH_TIMEOUT_SECONDS=3600

# Public CSI endpoint used only by explicitly allow-listed Registry fallbacks.
PORTFOLIO_OPS_PLATFORM_CSINDEX_API_URL=https://www.csindex.com.cn/csindex-home
PORTFOLIO_OPS_PLATFORM_CSINDEX_TIMEOUT_SECONDS=30

# Direct FMP API source for on-demand US, Hong Kong, and China A-share equities.
PORTFOLIO_OPS_PLATFORM_FMP_API_KEY_FILE=/absolute/path/to/fmp_api_key
PORTFOLIO_OPS_PLATFORM_FMP_API_URL=https://financialmodelingprep.com/stable
PORTFOLIO_OPS_PLATFORM_FMP_TIMEOUT_SECONDS=30
