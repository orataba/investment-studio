{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "baseUrl": ".", "paths": { "react": ["node_modules/@types/react"], "react-dom": ["node_modules/@types/react-dom"], "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"], "react/jsx-dev-runtime": ["node_modules/@types/react/jsx-dev-runtime"] }
  },
  "include": ["src"]
}
