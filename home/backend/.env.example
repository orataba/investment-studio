INVESTMENT_STUDIO_HOME_ENVIRONMENT=local
INVESTMENT_STUDIO_HOME_FRONTEND_URL=http://127.0.0.1:5172
# Use the existing instance PostgreSQL; Home owns only the identity schema.
# Store the password in the service user's 0600 .pgpass, outside this repository.
INVESTMENT_STUDIO_HOME_DATABASE_URL=postgresql+psycopg://investment_studio@127.0.0.1:5432/investment_studio
# home/apps.json owns the entry list; override addresses for each deployment.
INVESTMENT_STUDIO_HOME_APP_URLS={}
INVESTMENT_STUDIO_HOME_CORS_ORIGINS=http://127.0.0.1:5172,http://localhost:5172
# Local HTTP only; all business applications must use the same cookie name.
INVESTMENT_STUDIO_HOME_AUTH_COOKIE_NAME=studio_session
INVESTMENT_STUDIO_HOME_AUTH_COOKIE_SECURE=false
# Production: use HTTPS, __Secure-yungu_session and the shared deployment cookie domain.
# INVESTMENT_STUDIO_HOME_AUTH_COOKIE_DOMAIN=.example.com
# Bootstrap explicitly via python -m home_api.cli; old single-account variables no longer authenticate.
